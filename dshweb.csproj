<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>dsh-web</AssemblyName>
    <RootNamespace>DshWebLauncher</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>dsh web</Product>
    <Company>dsh</Company>
    <Description>dsh web 托盘版启动器</Description>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WinForms 的 DPI 配置放这里，manifest 里重复声明会触发 WFAC010 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\running.ico" />
    <EmbeddedResource Include="assets\stopped.ico" />
    <EmbeddedResource Include="assets\busy.ico" />
    <None Include="assets\running.ico" CopyToOutputDirectory="PreserveNewest" Link="assets\running.ico" />
    <None Include="assets\stopped.ico" CopyToOutputDirectory="PreserveNewest" Link="assets\stopped.ico" />
    <None Include="assets\busy.ico" CopyToOutputDirectory="PreserveNewest" Link="assets\busy.ico" />
  </ItemGroup>
</Project>
